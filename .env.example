# Copy this file to .env and fill in the keys for the tools you use.
# Core model and default web search
OPENAI_API_KEY=
SERPAPI_API_KEY=

# Image search
IMGBB_API_KEY=
SEARCH_API_KEY=

# Literature and document parsing (use --no-springer without Springer keys)
SPRINGER_API_KEY=
LLAMA_API_KEY=

# OCR services
TRANSKRIBUS_USERNAME=
TRANSKRIBUS_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=

# Optional: public HistBench data does not require authentication
HF_TOKEN=

# Disable browser-use telemetry
ANONYMIZED_TELEMETRY=false
